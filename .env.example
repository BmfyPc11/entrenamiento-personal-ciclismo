# Copia este archivo como .env.local y rellena los valores.
# Los tres primeros los obtienes en https://www.strava.com/settings/api

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# En local dejalo tal cual. En Vercel pon la URL de tu proyecto,
# por ejemplo https://cuaderno-de-ruta.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
